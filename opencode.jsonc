{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "question": "allow"
  },
  "agent": {
    "general": {
      "mode": "subagent",
      "permission": {
        "question": "deny"
      }
    },
    "explore": {
      "mode": "subagent",
      "permission": {
        "question": "deny"
      },
      "tools": {
        "goal": true
      }
    },
    "scout": {
      "mode": "subagent",
      "permission": {
        "question": "deny"
      }
    }
  },
  "provider": {
    "deepseek-beta": {
      "name": "DeepSeek Beta",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "REDACTED"
      },
      "models": {
        "deepseek-v4.1-flash-expires-on-0910": {
          "reasoning": true,
          "tool_call": true,
          "variants": {
            "none": {
              "reasoning": false
            },
            "medium": {
              "disabled": true
            },
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    }
  },
  "plugin": [
    [
      "/root/opencode-goal-plugin/dist/index.js",
      {
        "maxTurns": 100,
        "stuckTimeoutMs": 600000,
        "autoAbortSubagent": true,
        "cleanupDays": 3,
        "maxRetainedSubagents": 60
      }
    ]
  ],
  "command": {
    "goal": {
      "template": "/goal $ARGUMENTS",
      "agent": "z-goal",
      "description": "设置目标并持续自主推进直到完成",
      "subtask": false
    },
    "goal-iter": {
      "template": "/goal-iter $ARGUMENTS",
      "agent": "z-goal",
      "description": "设置目标并临时开启一次迭代模式",
      "subtask": false
    }
  }
}
